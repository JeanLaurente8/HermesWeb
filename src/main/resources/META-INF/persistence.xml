<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">
    <persistence-unit name="HermesPU" transaction-type="RESOURCE_LOCAL">

        <class>modelo.Areatrabajo</class>
        <class>modelo.Empleado</class>
        <class>modelo.Proveedor</class>
        <class>modelo.Articulo</class>
        <class>modelo.Solicitud</class>
        <class>modelo.Ordencompra</class>
        <class>modelo.Conformidad</class>

        <properties>
            <property name="javax.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>
            <property name="javax.persistence.jdbc.url"      value="jdbc:mysql://localhost:3306/gestion_oc_alerta?useSSL=false&amp;serverTimezone=America/Lima"/>
            <property name="javax.persistence.jdbc.user"     value="root"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect"               value="org.hibernate.dialect.MySQL8Dialect"/>
            <property name="hibernate.hbm2ddl.auto"          value="update"/>
            <property name="hibernate.show_sql"              value="true"/>
        </properties>
    </persistence-unit>
</persistence>